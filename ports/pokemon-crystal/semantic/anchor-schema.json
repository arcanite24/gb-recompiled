{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gbrecompiled.example/schemas/crystal-semantic-anchors-v1.json",
  "title": "Crystal Recompiled semantic anchor inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "rom_sha256",
    "anchors"
  ],
  "properties": {
    "schema": {
      "const": "crystal-recompiled.semantic-anchors"
    },
    "version": {
      "const": 1
    },
    "rom_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/anchor"
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source"
      ],
      "properties": {
        "kind": {
          "enum": [
            "pinned-disassembly",
            "hardware-reference"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "addressAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "symbol",
        "memory_space",
        "bank",
        "address",
        "width",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "memory_space": {
          "enum": [
            "physical_rom",
            "vram",
            "external_ram",
            "wram",
            "banked_wram",
            "hram",
            "mmio"
          ]
        },
        "bank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 511
        },
        "address": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{4}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "rtcAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "register",
        "memory_space",
        "selector",
        "width",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^rtc\\.[a-z][a-z0-9_.-]*$"
        },
        "register": {
          "enum": [
            "seconds",
            "minutes",
            "hours",
            "day_low",
            "day_high"
          ]
        },
        "memory_space": {
          "const": "rtc"
        },
        "selector": {
          "type": "integer",
          "minimum": 8,
          "maximum": 12
        },
        "width": {
          "const": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "anchor": {
      "oneOf": [
        {
          "$ref": "#/$defs/addressAnchor"
        },
        {
          "$ref": "#/$defs/rtcAnchor"
        }
      ]
    }
  }
}
